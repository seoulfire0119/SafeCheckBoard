rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function session(code) { return get(/databases/$(database)/documents/sessions/$(code)).data; }
    function member(code) {
      return signedIn() && exists(/databases/$(database)/documents/sessions/$(code)/members/$(request.auth.uid));
    }
    function owner(code) { return signedIn() && session(code).ownerId == request.auth.uid; }
    function editor(code) {
      return member(code) && session(code).closed == false
        && get(/databases/$(database)/documents/sessions/$(code)/members/$(request.auth.uid)).data.role in ['owner', 'editor'];
    }
    function validSession(data) {
      return data.keys().hasAll(['ownerId', 'closed', 'createdAt', 'updatedAt', 'buildings', 'states', 'personnelStats'])
        && data.ownerId is string && data.closed is bool
        && data.buildings is list && data.buildings.size() <= 3
        && data.states is list && data.states.size() == data.buildings.size()
        && data.personnelStats is list && data.personnelStats.size() == data.buildings.size()
        && data.size() <= 50;
    }
    match /sessions/{code} {
      allow get: if member(code) || owner(code);
      allow list, delete: if false;
      allow create: if signedIn() && code.matches('[A-Z0-9]{6}')
        && request.resource.data.ownerId == request.auth.uid && request.resource.data.closed == false
        && request.resource.data.buildings.size() >= 1
        && validSession(request.resource.data)
        && !exists(/databases/$(database)/documents/sessions/$(code));
      allow update: if validSession(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && (editor(code) || (owner(code) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closed', 'updatedAt'])))
        && (request.resource.data.closed == resource.data.closed || owner(code));
      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || owner(code));
        allow list: if owner(code);
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['role', 'name', 'joinedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 100
          && ((request.resource.data.role == 'viewer' && session(code).ownerId is string && session(code).closed == false)
            || (request.resource.data.role == 'owner'
              && getAfter(/databases/$(database)/documents/sessions/$(code)).data.ownerId == uid));
        allow update: if owner(code) && uid != session(code).ownerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['editor', 'viewer'];
        allow delete: if false;
      }
      match /logs/{id} {
        allow read: if member(code);
        allow create: if editor(code)
          && request.resource.data.keys().hasAll(['at', 'atMs', 'actor', 'actorUid', 'category', 'text'])
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.atMs is number
          && request.resource.data.actor is map
          && request.resource.data.text is string && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }
      match /chat/{id} {
        allow read: if member(code);
        allow create: if editor(code) && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.timestamp == request.time
          && request.resource.data.text is string && request.resource.data.text.size() <= 500
          && request.resource.data.sender is string && request.resource.data.sender.size() <= 30;
        allow update, delete: if false;
      }
      match /briefings/{id} {
        allow read: if member(code);
        allow create, update: if editor(code)
          && request.resource.data.keys().hasAll(['title', 'tabType', 'fields'])
          && request.resource.data.title is string && request.resource.data.title.size() <= 200
          && request.resource.data.tabType is int && request.resource.data.tabType >= 0 && request.resource.data.tabType <= 2
          && request.resource.data.fields is map;
        allow delete: if owner(code) && session(code).closed == false;
      }
      match /secondary/{id} {
        allow read: if member(code);
        allow create, update: if editor(code) && id == 'map'
          && request.resource.data.items is list && request.resource.data.lines is list;
        allow delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
