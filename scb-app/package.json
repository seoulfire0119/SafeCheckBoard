{
  "name": "scb-app",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node --test tests/*.test.cjs",
    "test:rules": "node --test tests/firestore.rules.test.mjs",
    "test:e2e": "playwright test",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-safecheckboard"
  },
  "dependencies": {
    "firebase": "10.14.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.12",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "react-test-renderer": "^18.3.1",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
