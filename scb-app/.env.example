VITE_FB_STORAGE_BUCKET=safecheckboard.firebasestorage.app
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=
# 개발 중 로컬 에뮬레이터를 쓰려면 .env.development.local 에 VITE_USE_EMULATOR=1

